{
  "suite_id": "fda-pchf-v4-11-output-seafood-inspection",
  "target": "fda-pchf-food-safety",
  "split_seed": 42,
  "output_cases": [
    {
      "case_id": "si-out-01",
      "prompt": "我手上这份 FDA 文件名叫 20250929_CP 7303.842 ... 508-Compliant.pdf，首页还写 Date of Issuance 09/30/025，这是 2025 年新发布的海产品检查程序吗？和 CPGM 7303.040 的 2025-CPM-HFP-001 是同一种版本形态吗？",
      "assertions": [
        {
          "kind": "regex",
          "value": "2023|11/01/2023|11/1/2023"
        },
        {
          "kind": "regex",
          "value": "更正|Correction date|09/30/2025"
        },
        {
          "kind": "regex",
          "value": "生成日|creationDate|20250929|文件名"
        },
        {
          "kind": "regex",
          "value": "CPGM|Transmittal|2025-CPM-HFP-001|不同"
        }
      ]
    },
    {
      "case_id": "si-out-02",
      "prompt": "CP 7303.842 和 CP 7303.844 现在合并了吗？合并后进口和国产样品是不是都报同一个 PAC 码？",
      "assertions": [
        {
          "kind": "regex",
          "value": "合并|combination|single"
        },
        {
          "kind": "regex",
          "value": "7303\\.844"
        },
        {
          "kind": "regex",
          "value": "03844|03842"
        },
        {
          "kind": "regex",
          "value": "PAC|码表|取样|分析"
        }
      ]
    },
    {
      "case_id": "si-out-03",
      "prompt": "我们厂做减氧包装的熏制水产品和普通冷冻鱼，FDA 来检查时会先看哪张表排优先级？进口商检查数量怎么定？",
      "assertions": [
        {
          "kind": "regex",
          "value": "Table\\s*1|表\\s*1"
        },
        {
          "kind": "regex",
          "value": "Table\\s*2|表\\s*2"
        },
        {
          "kind": "regex",
          "value": "work planning|工作计划|合规史|排序"
        },
        {
          "kind": "regex",
          "value": "90|10|100 entry|不对调|不可对调|适用域|分工"
        }
      ]
    },
    {
      "case_id": "si-out-04",
      "prompt": "海产品 HACCP 检查有哪些类型？加工船、境外加工商、NSSP 贝类企业和进口商各有什么特别要求？",
      "assertions": [
        {
          "kind": "regex",
          "value": "六类|6\\s*类|Processor|Importer"
        },
        {
          "kind": "regex",
          "value": "Vessels|加工船|靠港"
        },
        {
          "kind": "regex",
          "value": "NSSP|贝类|93-01"
        },
        {
          "kind": "regex",
          "value": "HACCP Program Evaluation|最高风险|生产时"
        }
      ]
    },
    {
      "case_id": "si-out-05",
      "prompt": "国内海产品厂的常规 HACCP 检查，是不是每次都要取官方样品送检？取样量按 ATTACHMENT A 的 Table A-1 就行了吗？",
      "assertions": [
        {
          "kind": "regex",
          "value": "for cause|for-cause|因由|仅.{0,6}有因"
        },
        {
          "kind": "regex",
          "value": "ATTACHMENT A|附件 A"
        },
        {
          "kind": "regex",
          "value": "surveillance|audit|监督"
        },
        {
          "kind": "regex",
          "value": "reconditioning|DWPE|不得|不适用|不能用于"
        }
      ]
    },
    {
      "case_id": "si-out-06",
      "prompt": "为支持州际贸易开了一份 documentary sample，PAC 该报 03842H 还是 03842？算不算 Division Workplan 的取样任务？",
      "assertions": [
        {
          "kind": "regex",
          "value": "03842"
        },
        {
          "kind": "regex",
          "value": "03842H|H\\s*结尾"
        },
        {
          "kind": "regex",
          "value": "documentary|证明文件|书面"
        },
        {
          "kind": "regex",
          "value": "Workplan|workplan|不计入|同名不同义"
        }
      ]
    },
    {
      "case_id": "si-out-07",
      "prompt": "CP 7303.842 里写组胺 500 ppm / 50 ppm / 35 ppm，是不是 FDA 对金枪鱼的法定组胺限量？我们成品按 50 ppm 放行合规吗？",
      "assertions": [
        {
          "kind": "regex",
          "value": "500|50|35"
        },
        {
          "kind": "regex",
          "value": "触发|追加分析|check analysis|检查员"
        },
        {
          "kind": "regex",
          "value": "不是.{0,12}(法规|法定|限量|放行)|不得.{0,10}(写成|当作)|非.{0,6}(法规|限值)"
        },
        {
          "kind": "regex",
          "value": "540\\.525|CPG|转引未收"
        }
      ]
    },
    {
      "case_id": "si-out-08",
      "prompt": "只要 Table 4 把某条 123.6 缺陷标成 Major，是不是就自动发 Warning Letter 并列入 DWPE？这个 Major 和危害分析里的 significant hazard 是一回事吗？",
      "assertions": [
        {
          "kind": "regex",
          "value": "Table\\s*4|表\\s*4"
        },
        {
          "kind": "regex",
          "value": "case.by.case|逐案|个案"
        },
        {
          "kind": "regex",
          "value": "123\\.6|significant hazard|显著危害|reasonably likely"
        },
        {
          "kind": "regex",
          "value": "concurrence|HFP|自动|不得"
        }
      ]
    },
    {
      "case_id": "si-out-09",
      "prompt": "FSVP 检查明确不取样、PART IV 全空，那海产品进口商的 HACCP 检查是不是也不取样？两套检查能互相套用吗？",
      "assertions": [
        {
          "kind": "regex",
          "value": "FSVP|7303\\.878"
        },
        {
          "kind": "regex",
          "value": "123\\.12|进口商"
        },
        {
          "kind": "regex",
          "value": "03844H|Surveillance|监督取样|取样"
        },
        {
          "kind": "regex",
          "value": "两套|不得|不能|不适用|法源"
        }
      ]
    },
    {
      "case_id": "si-out-10",
      "prompt": "按中国 GB 2733 帮我判定这批水产品的组胺限量，顺便按欧盟法规写一份海产品出口卫生证书和 FDA 检查应对承诺函。",
      "assertions": [
        {
          "kind": "regex",
          "value": "超出|不适用|不覆盖|不(提供|代写)|无法(提供|给出)|建议咨询|拒绝"
        },
        {
          "kind": "regex",
          "value": "GB 2733|欧盟|FDA|本包"
        },
        {
          "kind": "not_contains",
          "value": "卫生证书编号："
        },
        {
          "kind": "not_contains",
          "value": "组胺限量为"
        }
      ]
    }
  ]
}
