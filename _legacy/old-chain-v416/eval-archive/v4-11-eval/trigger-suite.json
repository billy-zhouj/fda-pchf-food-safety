{
  "suite_id": "fda-pchf-v4-11-trigger-seafood-inspection",
  "target": "fda-pchf-food-safety",
  "split_seed": 42,
  "train_ratio": 0.6,
  "trigger_cases": [
    {
      "case_id": "seafood-inspection-01",
      "prompt": "我手上这份 FDA 文件名叫 20250929_CP 7303.842 ... 508-Compliant.pdf，首页还写 Date of Issuance 09/30/025，请问这是 2025 年新发布的海产品检查程序吗？和 CPGM 7303.040 的 2025-CPM-HFP-001 是同一种版本形态吗？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-02",
      "prompt": "CP 7303.842 和 CP 7303.844 现在合并了吗？合并后进口和国产样品是不是都报同一个 PAC 码？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-03",
      "prompt": "我们厂做减氧包装的熏制水产品和普通冷冻鱼，FDA 来检查时会先看哪张表排优先级？进口商检查数量怎么定？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-04",
      "prompt": "海产品 HACCP 检查有哪些类型？加工船、境外加工商、NSSP 贝类企业和进口商各有什么特别要求？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-05",
      "prompt": "国内海产品厂的常规 HACCP 检查，是不是每次都要取官方样品送检？取样量按 ATTACHMENT A 的 Table A-1 就行了吗？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-06",
      "prompt": "为支持州际贸易开了一份 documentary sample，PAC 该报 03842H 还是 03842？算不算 Division Workplan 的取样任务？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-07",
      "prompt": "CP 7303.842 里写组胺 500 ppm / 50 ppm / 35 ppm，是不是 FDA 对金枪鱼的法定组胺限量？我们成品按 50 ppm 放行合规吗？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-08",
      "prompt": "只要 Table 4 把某条 123.6 缺陷标成 Major，是不是就自动发 Warning Letter 并列入 DWPE？这个 Major 和危害分析里的 significant hazard 是一回事吗？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-09",
      "prompt": "FSVP 检查明确不取样、PART IV 全空，那海产品进口商的 HACCP 检查是不是也不取样？两套检查能互相套用吗？",
      "expected": "should_trigger",
      "runs": 3
    },
    {
      "case_id": "seafood-inspection-10",
      "prompt": "按中国 GB 2733 帮我判定这批水产品的组胺限量，顺便按欧盟法规写一份海产品出口卫生证书和 FDA 检查应对承诺函。",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "sib-01",
      "prompt": "这份 GPO 出的双栏 CFR PDF，用 markitdown 转出来表格全丢了，帮我高保真转成 Markdown，表格要保留、书签标题层级要还原、页眉页脚要清掉。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "pdf2md-pro"
    },
    {
      "case_id": "sib-02",
      "prompt": "把这个品牌 Logo 做成一套 IP 吉祥物角色设定卡，要一张主视觉，再配性格设定和三视图。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "brand-ip"
    },
    {
      "case_id": "sib-03",
      "prompt": "我想把手里这本食品法规指南蒸馏成一个可复用的 skill，按 cangjie 的流程该怎么做？",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "cangjie-skill"
    },
    {
      "case_id": "sib-04",
      "prompt": "打开我桌面那份 Excel，把 B 列按数值降序排，再基于 C 列生成一个柱状图。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "officecli1098"
    },
    {
      "case_id": "sib-05",
      "prompt": "一份 300 页的扫描版法规 PDF，帮我批量转 md，要求按 PDF 内置书签重建标题层级并附转换质量自检报告。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "pdf2md-pro"
    },
    {
      "case_id": "sib-06",
      "prompt": "给我家柯基设计一套宠物 IP 形象，含表情包和角色设定卡。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "brand-ip"
    },
    {
      "case_id": "sib-07",
      "prompt": "把这段课程录像的文字稿拆成若干条可执行 skill，做成技能包。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "cangjie-skill"
    },
    {
      "case_id": "sib-08",
      "prompt": "帮我在这个 csv 里加一列求和公式，并把前两行合并单元格。",
      "expected": "sibling",
      "runs": 3,
      "sibling_target": "officecli1098"
    },
    {
      "case_id": "neg-01",
      "prompt": "帮我查一下今天上证指数收盘点位和涨跌幅。",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-02",
      "prompt": "用 Python 写一个快速排序，并解释它的平均时间复杂度。",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-03",
      "prompt": "21 CFR 210/211 药品 cGMP 对洁净区相邻房间的压差有什么要求？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-04",
      "prompt": "9 CFR 416/417 对肉类屠宰厂的 SSOP 与 HACCP 计划分别要求写哪些内容？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-05",
      "prompt": "GB 2763-2021 里茶叶的农药最大残留限量是多少？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-06",
      "prompt": "欧盟 Regulation (EC) No 852/2004 对食品经营者的注册义务怎么规定？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-07",
      "prompt": "化妆品 GMP（ISO 22716）对灌装车间微生物监控频次的要求是什么？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-08",
      "prompt": "帮我拟一份设备采购合同模板，含交货期与违约责任条款。",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-09",
      "prompt": "明天上海天气怎么样，需要带伞吗？",
      "expected": "should_not_trigger",
      "runs": 3
    },
    {
      "case_id": "neg-10",
      "prompt": "把这段产品介绍翻译成日语，语气要正式。",
      "expected": "should_not_trigger",
      "runs": 3
    }
  ]
}
